# Defaults and examples for a native run. The binary reads the process
# environment, not this file. Copy it to .env and export the settings you want.

# HTTP listen port (integer 1–65535).
PORT=8080
# Browser-facing origin: lowercase scheme and host, optional non-default
# port, no path, query, fragment, userinfo or trailing slash.
# Default is http://localhost with PORT appended unless PORT is 80.
# BASE_URL=http://localhost:8080
# Only lowercase true or false; unset defaults to false, empty is invalid.
# false permits local HTTP; true requires HTTPS and enables secure cookies.
COOKIE_SECURE=false
# Non-blank display name shown in the page title.
SITE_NAME="My App"

# First-admin setup secret, unset by default. At least 32 characters, with no
# whitespace or control characters. Use a value OR a file, not both.
SETUP_TOKEN=
# Read the token from a regular file (max 64 KiB); one final LF or CRLF is stripped.
SETUP_TOKEN_FILE=
# Sign-in expiry after inactivity, a positive Go duration no greater than the absolute limit.
# Idle expiry cannot be disabled through the environment.
SESSION_IDLE=2h
# Hard sign-in expiry, a positive Go duration.
SESSION_ABSOLUTE=12h
# remote uses the socket peer, which is right for local runs. The Kamal deploy
# sets forwarded in config/deploy.yml. forwarded requires the sole ingress to
# replace X-Forwarded-For. cloudflare requires sole ingress that sets
# CF-Connecting-IP.
CLIENT_IP_SOURCE=remote
# Integer 1–64; size for available memory (about 64 MiB per operation).
PASSWORD_CONCURRENCY=2

# Minimum log severity: debug, info, warn, error.
LOG_LEVEL=info
# Log encoding: json or text.
LOG_FORMAT=json
# Time allowed to drain HTTP requests, a positive Go duration.
SHUTDOWN_TIMEOUT=15s

# Relay host or IP, without a port; empty disables mail.
SMTP_HOST=
# Relay port (integer 1–65535).
SMTP_PORT=587
# Optional non-blank login; requires a password and TLS when supplied.
SMTP_USERNAME=
# Relay password, unset by default. Use a value OR a file, not both.
SMTP_PASSWORD=
# Read the relay password from a regular file (max 64 KiB); one final LF or CRLF is stripped.
SMTP_PASSWORD_FILE=
# starttls (required upgrade), tls (implicit TLS), or none (unauthenticated local development only).
SMTP_TLS=starttls
# Sender mailbox, required with SMTP_HOST; otherwise empty.
EMAIL_FROM=

# SQLite filename on local storage, not a DSN or an in-memory database.
# The container image instead defaults to /data/app.db.
DB_PATH=data/app.db
# Directory for scheduled copies; defaults to "backups" beside DB_PATH.
# BACKUP_DIR=data/backups
# Number of daily backups retained (non-negative integer); 0 disables scheduled backups.
BACKUP_KEEP=14
