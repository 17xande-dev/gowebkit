# References only, never values. Kamal reads each name from the environment of
# the shell that runs it; load the gitignored .env.production first (see
# docs/deploy.md). DATABASE_URL must carry the same password as
# POSTGRES_PASSWORD, with a URL-safe value such as `openssl rand -hex 32`.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=$DATABASE_URL
SMTP_PASSWORD=$SMTP_PASSWORD
